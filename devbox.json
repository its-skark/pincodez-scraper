{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.18.4/.schemas/devbox.schema.json",
  "packages": [
    "python@3.12",
    "uv@0.13.4",
    "sqlite",
    "jq",
    "ripgrep",
    "curl"
  ],
  "env": {
    "PYTHONUNBUFFERED": "1",
